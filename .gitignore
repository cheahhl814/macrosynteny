# Python artifacts
__pycache__/
*.pyc
*.egg-info/

# OS / editor
.DS_Store
*.swp
*~

# Pixi env cache + lockfile (resolved on first run, regenerated per machine)
/.pixi/
pixi.lock

# Per-run working outputs — must not be committed
work/
results/

# Docs-corpus fetch cache (regenerable via skill-update-check)
docs-corpus/.fingerprints

# Meta-skill run artifacts (per-run, regenerable by re-running bioinfo-skill-creator)
# — NOT part of the skill's operational deliverable; never commit them to GitHub.
# params.json IS tracked (it is the render input that makes a re-run reproducible).
skill-built.md
battle-test-report.md
battle-test_evidence.txt
preflight.md
preflight_evidence.txt
tool_search_results.txt
tool-inventory.json
# Battle-test transient scratch
.battle-test-scratch/
exec-canary-report.md
exec-canary_evidence.txt

# Agent-session local state (Claude Code / OpenCode run with cwd = this repo)
# — permissions allowlists etc. are machine/session-local; global git ignores
# cover settings.local.json, but ship the guard in-repo too.
.claude/
.opencode/

# Snakemake state (ntSynt / ntSynt-viz are snakemake-driven; a run executed
# inside the skill dir instead of $RUN_DIR must not ship)
.snakemake/

# R stray (ntSynt-viz/R plotting in the caller's cwd)
Rplots.pdf
